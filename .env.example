# ===== Hyonix 监控 · 环境变量示例 =====
# 复制为 .env 并按需修改（一键安装脚本会自动生成）。Docker 部署时由 docker-compose 读取。

# ---- Hyonix 账号 ----
# 用于自动登录 my.hyonix.com 读取库存；登录由内置浏览器全自动完成（含 Cloudflare 验证）。
# 这里只是初始值：之后在后台「设置 → Hyonix 账号」修改即可（后台设置优先，无需重启）。
# 密码含 | $ # 等特殊字符时请用单引号包住，如 HYONIX_PASSWORD='a|b$c'
HYONIX_EMAIL=
HYONIX_PASSWORD=

# 管理后台账号：首次启动自动创建 admin / admin，首次登录必须修改密码（不在这里配置）。
# 忘记密码：docker compose exec hyonix-monitor python -m app.reset_admin

# 会话签名密钥（务必改成随机长字符串！可用: python -c "import secrets;print(secrets.token_hex(32))"）
APP_SECRET_KEY=please-change-this-to-a-random-secret

# ---- Docker ----
# 对外访问端口（宿主机端口），访问 http://服务器IP:端口
HYONIX_PORT=23988
# 镜像版本：latest = 最新发布版；也可锁定为具体版本号，如 1.0.0
HYONIX_VERSION=latest

# ---- 应用 ----
# 显示时区（数据库内部统一存 UTC，仅展示时换算）
DISPLAY_TZ=Asia/Shanghai

# 全局目录同步间隔（小时）—— 新机房/新套餐/价格变更检测。全站数据只有一个页面，开销很小
CATALOG_SYNC_HOURS=1

# 轮询礼貌性：单任务最小间隔（秒）。每次抓取约 150 KB，过于频繁可能被风控
MIN_INTERVAL_SECONDS=20

# 登录用浏览器：留空自动选择（Docker amd64 = Google Chrome，arm64 = Chromium）
# 本机（Windows/macOS）开发调试可设为 chrome 或 msedge
BROWSER_CHANNEL=

# Hyonix 客户中心地址（一般无需修改）
HYONIX_BASE=https://my.hyonix.com

# 数据目录：本地开发用 ./data；Docker 中固定为 /data（由 docker-compose 覆盖）
DATA_DIR=./data
